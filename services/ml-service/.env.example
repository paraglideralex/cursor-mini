# CodeLens ML Service - переменные окружения

# Путь к config.json (относительно корня CodeLens или абсолютный)
# CODELENS_CONFIG=.assistant/config.json

# Переопределение путей из config (опционально)
# CODELENS_STORAGE_ROOT=.codelens_storage
# CODELENS_LLM_MODEL=models/llm/qwen2.5-coder-7b-instruct-q4_k_m.gguf
# CODELENS_EMBEDDING_MODEL=models/embeddings/multilingual-e5-large

# Порт сервиса (по умолчанию 8000)
# CODELENS_ML_PORT=8000
